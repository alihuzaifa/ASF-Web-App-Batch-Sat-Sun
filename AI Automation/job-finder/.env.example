# Job Finder settings. Copy this file to .env (which is never committed) and edit it.
HEADLESS=true
BROWSER_CHANNEL=chrome
# 1 = normal speed. 2 = twice as slow between page loads (use it if sites keep limiting you).
SLOWDOWN=1
APPLY_DELAY_MIN_MS=30000
APPLY_DELAY_MAX_MS=60000
MATCH_MODEL=sonnet
TAILOR_MODEL=sonnet
SEARCH_MODEL=sonnet
CLAUDE_MAX_BUDGET_USD=0.5

# Gmail: turn on 2-step verification, then create an app password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

UI_PORT=3100
